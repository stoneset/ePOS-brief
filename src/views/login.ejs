<%- include('partials/head') %>
<div class="row justify-content-center mt-5">
  <div class="col-sm-8 col-md-5 col-lg-4">
    <pre class="text-center fw-bold small mb-3">      ___  ___  ___
 ___ | _ \/ _ \/ __|
/ -_)|  _/ (_) \__ \
\___||_|  \___/|___/
  -----  B R I E F  -----</pre>
    <div class="card shadow-sm">
      <div class="card-body">
        <h1 class="h5 mb-3">Connexion</h1>
        <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
        <form method="post" action="/login">
          <div class="mb-3">
            <label class="form-label" for="username">Identifiant</label>
            <input class="form-control" id="username" name="username" autocomplete="username" required autofocus>
          </div>
          <div class="mb-3">
            <label class="form-label" for="password">Mot de passe</label>
            <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required>
          </div>
          <button class="btn btn-dark w-100">Se connecter</button>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('partials/foot') %>
